# =============================================================================
# PIB Vila Canaan — Variáveis de Ambiente
# =============================================================================
# Copie este arquivo para .env.local e preencha com os seus valores reais.
# O arquivo .env.local está no .gitignore e NUNCA deve ser enviado ao repositório.
# =============================================================================


# -----------------------------------------------------------------------------
# SUPABASE
# Credenciais do projeto Supabase (banco de dados, autenticação e storage).
#
# Como obter:
#   1. Acesse https://app.supabase.com e abra o seu projeto
#   2. Vá em Settings → API
#   3. Copie os valores de "Project URL" e "anon / public" key
# -----------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui


# -----------------------------------------------------------------------------
# RESEND — Envio de e-mails
# Utilizado para enviar as mensagens do formulário de contato do site.
#
# Como obter:
#   1. Crie uma conta em https://resend.com
#   2. Vá em API Keys → Create API Key
#   3. Copie a chave gerada (começa com "re_")
# -----------------------------------------------------------------------------

RESEND_API_KEY=re_sua-chave-aqui


# -----------------------------------------------------------------------------
# E-MAIL DE CONTATO
# Endereço que receberá as mensagens enviadas pelo formulário de contato.
# Deve ser um e-mail verificado no painel do Resend.
#
# Como verificar:
#   1. No painel do Resend, vá em Domains ou Emails → Add
#   2. Confirme a propriedade do endereço/domínio
# -----------------------------------------------------------------------------

CONTACT_EMAIL=contato@suaigreja.com.br


# -----------------------------------------------------------------------------
# URL DO SITE
# URL pública do site em produção. Usada para gerar links absolutos e
# metadados de Open Graph (compartilhamento em redes sociais).
#
# Em desenvolvimento local, pode omitir (o padrão é https://pibvilacanaan.com.br).
# Em produção, defina com a URL real do site hospedado.
# -----------------------------------------------------------------------------

NEXT_PUBLIC_SITE_URL=https://pibvilacanaan.com.br


# -----------------------------------------------------------------------------
# FEATURE FLAGS
# Chaves para ativar ou desativar funcionalidades sem necessidade de redeploy.
# Úteis para rollback rápido em caso de problemas em produção.
#
# ATENÇÃO: Em produção, mantenha os valores recomendados abaixo.
#          Altere apenas em caso de emergência ou durante testes locais.
# -----------------------------------------------------------------------------

# Middleware de autenticação — protege as rotas /admin/* no servidor.
# true  → Middleware ativo (RECOMENDADO em produção)
# false → Bypass do middleware (somente para rollback de emergência)
NEXT_PUBLIC_USE_MIDDLEWARE_AUTH=true

# Rate limiting da API de contato — limita a 3 requisições por hora por IP.
# true  → Limite ativo (RECOMENDADO em produção)
# false → Sem limite (somente para testes locais)
NEXT_PUBLIC_USE_RATE_LIMITING=true